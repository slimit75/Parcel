{
	"name": "Parcel",
	"description": "Unofficial generator of manifest files for the Skunkscraft Updater.",
	"version": "3.0.0-dev",
	"author": "Ian Ward",
	"type": "module",
	"private": true,
	"homepage": "https://github.com/slimit75/Parcel",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/slimit75/Parcel.git"
	},
	"bugs": {
		"url": "https://github.com/slimit75/Parcel/issues"
	},
	"keywords": [
		"actions"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"engines": {
		"node": ">=24.0.0"
	},
