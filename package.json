	},
	"license": "Apache-2.0",
	"dependencies": {
		"@actions/artifact": "^6.3.1",
		"@actions/core": "^3.0.1",
		"@foxglove/crc": "^1.0.1",
		"minimatch": "^11.0.5"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.1",
		"@types/node": "^24.19.2",
		"rollup": "^4.68.2",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "*"
	}
